# Copy this file to .env and add your own token. Never commit .env.
# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenAI-compatible chat endpoint. The default is the Hugging Face Inference router.
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions

# Default model. Change in the page or here. Needs to be an instruct model you can access.
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Port for http://localhost:PORT
PORT=3000
